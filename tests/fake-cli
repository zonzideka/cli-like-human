#!/usr/bin/env bash
# Development-only fake coding CLI for tests/smoke.sh. Never installed.
# Selected through a symlink named grok or codex on a temporary PATH.
set -u
# Real coding CLIs put the tty in raw mode; do not echo pasted input into the log.
stty -echo 2>/dev/null || true
mode=${FAKE_MODE:-work}
name=${0##*/}
hook=

# Codex completion is a per-session notify hook passed as -c notify=[CMD,EVENT].
# Extract CMD with bash string operations only (no jq dependency).
if [ "$name" = codex ]; then
  for arg in "$@"; do
    case $arg in
      notify=*)
        rest=${arg#notify=}
        rest=${rest#\[}
        hook=${rest%%,*}
        hook=${hook%\]}
        hook=${hook#\"}
        hook=${hook%\"}
        ;;
    esac
  done
fi

notify_done() {
  [ -n "$hook" ] || return 0
  [ -x "$hook" ] || return 0
  CS_NAME=${CS_NAME:-} "$hook" done >/dev/null 2>&1 || true
}

spinner='-|'
spin() {
  i=0
  while :; do
    printf '\r%s' "${spinner:i%2:1}"
    i=$((i+1))
    sleep 0.5
  done
}

case $mode in
  work)
    i=0
    while [ "$i" -lt 3 ]; do
      i=$((i+1))
      printf '\rWorking %ss' "$i"
      sleep 1
    done
    printf '\n'
    notify_done
    # Clear busy text so idle detection can observe a quiet, stable screen.
    printf '\033[2J\033[H'
    printf '> '
    while :; do sleep 1; done
    ;;
  hang)
    printf 'Working\n'
    while :; do sleep 1; done
    ;;
  silent)
    while :; do sleep 1; done
    ;;
  spin)
    spin
    ;;
  spin-artifact)
    : > "${FAKE_ARTIFACT:?FAKE_ARTIFACT is required}"
    i=0
    while :; do
      printf '\r%s' "${spinner:i%2:1}"
      i=$((i+1))
      if [ $((i % 2)) -eq 0 ]; then printf 'progress %s\n' "$i" >> "$FAKE_ARTIFACT"; fi
      sleep 0.5
    done
    ;;
  die)
    exit 3
    ;;
  prompt)
    printf 'Do you want to proceed?\n'
    while :; do sleep 1; done
    ;;
  *)
    printf 'fake-cli: unknown FAKE_MODE %s\n' "$mode" >&2
    exit 1
    ;;
esac
