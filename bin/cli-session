#!/usr/bin/env bash
# Named, persistent terminal sessions. Compatible with Bash 3.2.
set -eo pipefail
umask 077
ROOT=${CLI_SESSIONS_HOME:-$HOME/.cli-sessions}
REG=${CLI_SESSIONS_REG:-$ROOT/registry}
LOG=${CLI_LOGS:-$HOME/.cli-sessions/logs}
MARKS=${CLI_SESSIONS_MARKS_DIR:-$ROOT/marks}
HERE=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd -P)
fail() { printf 'cli-session: %s\n' "$*" >&2; exit 1; }
valid() { [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || fail 'names and labels must use letters, digits, underscores or hyphens'; }
number() { [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || fail 'expected a positive integer'; }
get() { cat "$REG/$n/$1" 2>/dev/null || true; }
put() { printf '%s\n' "$2" > "$REG/$n/$1"; }
quote() { printf '%q' "$1"; }
json() {
  local s=$1 char i
  printf '"'
  for ((i=0; i<${#s}; i++)); do
    char=${s:i:1}
    case $char in
      \\|\") printf '\\%s' "$char";;
      *) printf '%s' "$char";;
    esac
  done
  printf '"'
}
alive() { tmux has-session -t "=cs-$n" 2>/dev/null; }
mark() { CS_NAME=$n CLI_SESSIONS_MARKS_DIR=$MARKS "$HERE/cli-session-mark" "$@"; }
now() { date +%s; }
mtime() { stat -c %Y -- "$1" 2>/dev/null || stat -f %m -- "$1" 2>/dev/null || true; }
fsize() { if [ -f "$1" ]; then wc -c < "$1" | tr -d ' '; else printf '%s' '-'; fi; }
pane_state() {
  local out dead rc
  out=$(tmux display-message -p -t "=cs-$n:" '#{pane_dead} #{pane_dead_status}' 2>/dev/null) || { printf 'gone'; return; }
  [ -n "${out// /}" ] || { printf 'gone'; return; }
  dead=${out%% *}; rc=${out#* }
  [ "$rc" = "$out" ] && rc=
  if [ "$dead" = 1 ]; then [ -n "$rc" ] || rc=-; printf 'dead %s' "$rc"; else printf 'alive'; fi
}
liveness() {
  local ps rc
  ps=$(pane_state)
  [ "$ps" != gone ] || { printf 'gone'; return; }
  if [ -f "$MARKS/$n.exit" ]; then
    rc=$(cat "$MARKS/$n.exit" 2>/dev/null || true); [ -n "$rc" ] || rc=-
    printf 'exited %s' "$rc"; return
  fi
  case $ps in dead\ *) printf '%s' "$ps";; *) printf 'alive';; esac
}
PROMPT_RE='Update now|trust this folder|trust.*directory|Trust and continue|Press Enter to continue|I agree|Choose.*theme|Choose the text style|Do you want to|Allow .*\?|Run this command\?|data.sharing|Help improve'
BUSY_RE='esc to interrupt|ctrl\+c:cancel|esc to cancel|ctrl\+c to (stop|interrupt)|Working|Thinking|Running|Generating'
usage() {
  cat <<'HELP'
Usage: cli-session start [--bot LABEL] [--native-id ID] NAME CLI [DIR] [-- CLI_ARGS...]
       cli-session send NAME TEXT... | send NAME -
       cli-session key NAME KEY...
       cli-session read NAME [LINES]
       cli-session wait NAME [--timeout SECONDS] [--stable SECONDS] [--lines N] [--stall SECONDS] [--artifact PATH]
       cli-session status NAME [--stall SECONDS] [--artifact PATH] [--lines N]
       cli-session list | attach-hint NAME | stop NAME
CLI: claude, codex, grok, agy. stop requests normal exit; it never kills tmux.
HELP
}
cmd=${1:-help}; [ $# -eq 0 ] || shift
case $cmd in
  help|--help|-h) usage; exit 0;;
  start|send|key|read|wait|status|list|attach-hint|stop) ;;
  *) usage; exit 1;;
esac
command -v tmux >/dev/null || fail 'tmux is required'
case $cmd in
start)
  label=${CS_BOT:-}; native=
  while [ $# -gt 0 ]; do
    case $1 in
      --bot|--native-id) [ $# -ge 2 ] || fail 'missing option value'; case $1 in --bot) label=$2; valid "$label";; *) native=$2; valid "$native";; esac; shift 2;;
      --native-id=*) native=${1#*=}; valid "$native"; shift;;
      --bot=*) label=${1#*=}; valid "$label"; shift;;
      *) break;;
    esac
  done
  [ -z "$label" ] || valid "$label"
  [ $# -ge 2 ] || fail 'start requires NAME and CLI'
  n=$1; c=$2; shift 2; valid "$n"
  case $c in claude|codex|grok|agy) ;; *) fail 'unsupported CLI';; esac
  dir=$PWD
  if [ $# -gt 0 ] && [ "$1" != -- ]; then dir=$1; shift; fi
  [ $# -eq 0 ] || { [ "$1" = -- ] || fail 'put CLI arguments after --'; shift; }
  dir=$(cd -- "$dir" >/dev/null && pwd -P) || fail 'project directory does not exist'
  case "$dir$HERE$REG$MARKS$LOG" in *$'\n'*|*$'\r'*|*$'\t'*) fail 'paths must not contain control characters';; esac
  command -v "$c" >/dev/null || fail "CLI not found: $c"
  reuse=0
  if alive; then
    [ -f "$MARKS/$n.exit" ] || fail 'session already exists; attach or send a follow-up'
    reuse=1
  fi
  mkdir -p "$REG/$n" "$MARKS" "$LOG"
  previous=$(get cli)
  [ -z "$previous" ] || { [ "$previous" = "$c" ] && [ "$(get dir)" = "$dir" ]; } || fail 'registered name belongs to a different CLI or directory'
  id=$(get id); [ -z "$native" ] || id=$native
  [ -z "$id" ] || valid "$id"
  if [ -n "$previous" ] && [ -z "$id" ]; then fail 'native ID unknown; restart with --native-id from the native session picker'; fi
  if [ -z "$id" ]; then
    case $c in claude|grok)
      hex=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
      id=${hex:0:8}-${hex:8:4}-4${hex:13:3}-a${hex:17:3}-${hex:20:12};;
    esac
  fi
  extra=("$@")
  has() { local f arg; for f in "$@"; do for arg in "${extra[@]}"; do case $arg in "$f"|"$f"=*) return 0;; esac; done; done; return 1; }
  auto=()
  if [ "${CS_NO_AUTO:-0}" != 1 ]; then
    case $c in
      claude) has --permission-mode || auto+=(--permission-mode acceptEdits)
        has --disallowedTools --disallowed-tools || auto+=(--disallowedTools Bash);;
      codex) has -a --ask-for-approval || auto+=(-a never)
        has -s --sandbox || auto+=(-s workspace-write);;
      grok) has --always-approve --permission-mode || auto+=(--always-approve)
        has --sandbox || auto+=(--sandbox workspace);;
      agy) has --mode || auto+=(--mode accept-edits)
        has --sandbox || auto+=(--sandbox);;
    esac
  fi
  args=("$c" "${auto[@]}")
  hook=$HERE/cli-session-hook
  case $c in
    claude)
      if [ -n "$previous$native" ]; then args+=(-r "$id"); else args+=(-n "$n" --session-id "$id"); fi
      start_hook="$(quote "$hook") start"; done_hook="$(quote "$hook") done"
      settings='{"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":'$(json "$start_hook")'}]}],"Stop":[{"hooks":[{"type":"command","command":'$(json "$done_hook")'}]}]}}'
      args+=(--settings "$settings");;
    codex) [ -z "$id" ] || args+=(resume "$id")
      args+=(-c "notify=[$(json "$hook"),\"done\"]");;
    grok) if [ -n "$previous$native" ]; then args+=(-r "$id"); else args+=(-s "$id"); fi;;
    agy) [ -z "$id" ] || args+=(--conversation "$id");;
  esac
  args+=("${extra[@]}")
  put cli "$c"; put dir "$dir"; put id "$id"
  [ -z "$label" ] || put bot "$label"
  rm -f "$MARKS/$n.sent" "$MARKS/$n.start" "$MARKS/$n.done" "$MARKS/$n.exit" "$MARKS/$n.screen"
  # Persist a quoted launcher, not a transcript or a second native session store.
  launcher=$REG/$n/launch
  {
    printf '#!/usr/bin/env bash\n'
    printf 'export CS_NAME=%q CLI_SESSIONS_HOME=%q CLI_SESSIONS_REG=%q CLI_SESSIONS_MARKS_DIR=%q\n' "$n" "$ROOT" "$REG" "$MARKS"
    printf 'set +e\n'
    printf '%q ' "${args[@]}"; printf '\nrc=$?\n'
    # shellcheck disable=SC2016
    printf '%q exit "$rc"\n' "$HERE/cli-session-mark"
    # shellcheck disable=SC2016
    printf 'exit "$rc"\n'
  } > "$launcher"
  # A gated pane lets logging attach before the CLI starts. Exited panes stay visible.
  gate=$REG/$n/ready; rm -f "$gate"
  run="while [ ! -f $(quote "$gate") ]; do sleep 1; done; exec bash $(quote "$launcher")"
  if [ "$reuse" = 1 ]; then
    tmux respawn-pane -t "=cs-$n:" -c "$dir" "$run" || fail 'could not respawn session pane'
  else
    tmux new-session -d -s "cs-$n" -x 200 -y 50 -c "$dir" "$run" || fail 'could not create session'
  fi
  tmux set-option -t "=cs-$n:" remain-on-exit on || fail 'could not configure retained pane'
  tmux pipe-pane -t "=cs-$n:" -o "cat >> $(quote "$LOG/$n.tty.log")" || fail 'could not configure terminal logging'
  : > "$gate"
  printf 'Started %s (%s). Use cli-session read %s before sending.\n' "$n" "$c" "$n"
  exit 0;;
list)
  printf 'NAME\tCLI\tNATIVE_ID\tLABEL\tDIRECTORY\tSTATE\tTURN\tLOG_AGE\n'
  for entry in "$REG"/*; do
    [ -d "$entry" ] || continue
    n=${entry##*/}; lv=$(liveness); state=$lv
    case $lv in
      exited\ *) state="exited:${lv#exited }";;
      dead\ *) state="dead:${lv#dead }";;
    esac
    token=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
    done_tok=$(cat "$MARKS/$n.done" 2>/dev/null || true)
    if [ -z "$token" ]; then turn=none; elif [ "$done_tok" = "$token" ]; then turn=done; else turn=pending; fi
    log_age=-; lm=$(mtime "$LOG/$n.tty.log")
    [ -n "$lm" ] && log_age=$(( $(now) - lm ))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$(get cli)" "$(get id)" "$(get bot)" "$(get dir)" "$state" "$turn" "$log_age"
  done
  exit 0;;
esac
[ $# -ge 1 ] || fail 'missing session name'
n=$1; shift; valid "$n"
if [ ! -d "$REG/$n" ]; then
  if [ "$cmd" = wait ]; then
    printf '[cli-session wait] session=%s cli=unknown mode=unknown result=gone elapsed=0s\n' "$n"
    exit 4
  elif [ "$cmd" = status ]; then
    printf '[cli-session status] session=%s cli=unknown mode=unknown result=gone pane=gone rc=- turn=none activity_age=- screen_age=- log_age=- log_bytes=-\n' "$n"
    exit 4
  fi
  fail 'unknown session'
fi
case $cmd in
send)
  [ $# -gt 0 ] || fail 'missing text'
  alive && [ ! -f "$MARKS/$n.exit" ] || fail 'CLI has exited'
  f=$(mktemp "$REG/$n/input.XXXXXXXX"); trap 'rm -f "$f"' EXIT
  if [ "$1" = - ]; then cat > "$f"; else printf '%s' "$*" > "$f"; fi
  # Serialize turns at the caller: a new dispatch invalidates previous done marks.
  mark sent
  tmux load-buffer -b "cs-$n" "$f"
  tmux paste-buffer -p -d -b "cs-$n" -t "=cs-$n:"
  sleep 1
  [ ! -f "$MARKS/$n.exit" ] || fail 'CLI exited during paste'
  tmux send-keys -t "=cs-$n:" Enter;;
key) [ $# -gt 0 ] || fail 'missing key'; [ ! -f "$MARKS/$n.exit" ] || fail 'CLI has exited'; tmux send-keys -t "=cs-$n:" "$@";;
read) lines=${1:-60}; number "$lines"; tmux capture-pane -p -J -t "=cs-$n:" -S "-$lines";;
wait)
  timeout=3600; stable=6; lines=15; stall=0; artifact=
  while [ $# -gt 0 ]; do
    case $1 in
      --timeout) [ $# -ge 2 ] || fail 'missing wait option value'; number "$2"; timeout=$2; shift 2;;
      --stable) [ $# -ge 2 ] || fail 'missing wait option value'; number "$2"; stable=$2; shift 2;;
      --lines) [ $# -ge 2 ] || fail 'missing wait option value'; number "$2"; lines=$2; shift 2;;
      --stall) [ $# -ge 2 ] || fail 'missing wait option value'; [[ $2 =~ ^[0-9]+$ ]] || fail 'expected a non-negative integer'; stall=$2; shift 2;;
      --artifact) [ $# -ge 2 ] || fail 'missing wait option value'; artifact=$2; shift 2;;
      *) fail 'unknown wait option';;
    esac
  done
  c=$(get cli); mode=idle; case $c in claude|codex) mode=hook;; esac
  token=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
  started=0; last=; same=0; begin=$SECONDS; rc=2; result=timeout
  screen_at=$begin; extra=; logf="$LOG/$n.tty.log"; track=0
  if [ "$stall" -gt 0 ] || [ -n "$artifact" ]; then track=1; fi
  while [ $((SECONDS-begin)) -lt "$timeout" ]; do
    screen=$(tmux capture-pane -p -J -t "=cs-$n:" 2>/dev/null) || { rc=4; result=gone; break; }
    current=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
    [ "$current" = "$token" ] || fail 'another dispatch replaced this turn'
    lv=$(liveness)
    case $lv in
      gone) rc=4; result=gone; break;;
      exited\ *) rc=4; result=gone; break;;
      dead\ *) rc=4; result=dead; break;;
    esac
    done_tok=$(cat "$MARKS/$n.done" 2>/dev/null || true)
    if [ -n "$token" ] && [ "$done_tok" = "$token" ] && [ "$mode" = hook ]; then rc=0; result=done; break; fi
    if printf '%s\n' "$screen" | tail -n 20 | grep -qiE "$PROMPT_RE"; then rc=3; result=prompt; break; fi
    busy=0
    printf '%s\n' "$screen" | tail -n 12 | grep -qiE "$BUSY_RE" && busy=1
    [ "$busy" = 0 ] || started=1
    if [ "$mode" = idle ] && [ -n "$token" ] && [ "$started" = 1 ] && [ "$busy" = 0 ] && [ "$screen" = "$last" ]; then
      same=$((same+1))
      if [ "$same" -ge "$stable" ]; then mark done; rc=0; result=done; break; fi
    else same=0; fi
    if [ "$screen" != "$last" ]; then screen_at=$SECONDS; fi
    last=$screen
    if [ "$track" = 1 ]; then
      screen_age=$((SECONDS-screen_at)); log_age=-
      lm=$(mtime "$logf"); [ -n "$lm" ] && log_age=$(( $(now) - lm ))
      activity_age=$screen_age; artifact_age=-; artifact_bytes=-
      if [ -n "$artifact" ]; then
        artifact_bytes=$(fsize "$artifact")
        am=$(mtime "$artifact"); [ -n "$am" ] || am=$(mtime "$MARKS/$n.sent")
        [ -n "$am" ] && artifact_age=$(( $(now) - am ))
        activity_age=$artifact_age
      else
        if [ "$log_age" != - ] && { [ "$activity_age" = - ] || [ "$log_age" -lt "$activity_age" ]; }; then activity_age=$log_age; fi
      fi
      extra=" activity_age=$activity_age screen_age=$screen_age log_age=$log_age log_bytes=$(fsize "$logf")"
      [ -n "$artifact" ] && extra="$extra artifact_age=$artifact_age artifact_bytes=$artifact_bytes"
      if [ "$stall" -gt 0 ] && [ "$activity_age" != - ] && [ "$activity_age" -ge "$stall" ]; then rc=5; result=stalled; break; fi
    fi
    sleep 1
  done
  printf '[cli-session wait] session=%s cli=%s mode=%s result=%s elapsed=%ss%s\n' "$n" "$c" "$mode" "$result" "$((SECONDS-begin))" "$extra"
  printf '%s\n' "${screen:-}" | tail -n "$lines"
  exit "$rc";;
status)
  stall=300; lines=15; artifact=
  while [ $# -gt 0 ]; do
    case $1 in
      --stall) [ $# -ge 2 ] || fail 'missing status option value'; [[ $2 =~ ^[0-9]+$ ]] || fail 'expected a non-negative integer'; stall=$2; shift 2;;
      --lines) [ $# -ge 2 ] || fail 'missing status option value'; [[ $2 =~ ^[0-9]+$ ]] || fail 'expected a non-negative integer'; lines=$2; shift 2;;
      --artifact) [ $# -ge 2 ] || fail 'missing status option value'; artifact=$2; shift 2;;
      *) fail 'unknown status option';;
    esac
  done
  c=$(get cli); mode=idle; case $c in claude|codex) mode=hook;; esac
  token=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
  done_tok=$(cat "$MARKS/$n.done" 2>/dev/null || true)
  if [ -z "$token" ]; then turn=none; elif [ "$done_tok" = "$token" ]; then turn=done; else turn=pending; fi
  screen=$(tmux capture-pane -p -J -t "=cs-$n:" 2>/dev/null) || {
    printf '[cli-session status] session=%s cli=%s mode=%s result=gone pane=gone rc=- turn=%s activity_age=- screen_age=- log_age=- log_bytes=-\n' "$n" "$c" "$mode" "$turn"
    exit 4
  }
  sf="$MARKS/$n.screen"; e=$(now)
  ck=$(printf '%s\n' "$screen" | cksum); sum=${ck%% *}
  old=$(cat "$sf" 2>/dev/null || true); old_sum=${old%% *}; old_epoch=${old#* }
  [ "$old" = "$old_epoch" ] && old_epoch=
  if [ "$sum" != "$old_sum" ]; then
    tmp=$(mktemp "$MARKS/.screen.XXXXXXXX")
    printf '%s %s\n' "$sum" "$e" > "$tmp"; mv -f "$tmp" "$sf"
    screen_age=-
  else
    screen_age=$((e-old_epoch))
  fi
  logf="$LOG/$n.tty.log"; log_age=-; lm=$(mtime "$logf")
  [ -n "$lm" ] && log_age=$((e-lm))
  log_bytes=$(fsize "$logf")
  activity_age=$screen_age; artifact_age=-; artifact_bytes=-
  if [ -n "$artifact" ]; then
    artifact_bytes=$(fsize "$artifact")
    am=$(mtime "$artifact"); [ -n "$am" ] || am=$(mtime "$MARKS/$n.sent")
    [ -n "$am" ] && artifact_age=$((e-am))
    activity_age=$artifact_age
  else
    if [ "$log_age" != - ] && { [ "$activity_age" = - ] || [ "$log_age" -lt "$activity_age" ]; }; then activity_age=$log_age; fi
    if [ "$activity_age" = - ] && [ -n "$token" ]; then
      sm=$(mtime "$MARKS/$n.sent"); [ -n "$sm" ] && activity_age=$((e-sm))
    fi
  fi
  lv=$(liveness); pane=alive; rc=-; code=2
  case $lv in
    gone) result=gone; pane=gone; code=4;;
    exited\ *) result=exited; rc=${lv#exited }; pane=dead; code=4;;
    dead\ *) result=dead; rc=${lv#dead }; pane=dead; code=4;;
  esac
  if [ "$code" -eq 2 ]; then
    if [ "$turn" = done ]; then result=done; code=0
    elif printf '%s\n' "$screen" | tail -n 20 | grep -qiE "$PROMPT_RE"; then result=prompt; code=3
    elif [ "$turn" = none ]; then result=idle; code=0
    elif [ "$stall" -gt 0 ] && [ "$activity_age" != - ] && [ "$activity_age" -ge "$stall" ]; then result=stalled; code=5
    else result=active; code=2
    fi
  fi
  note=
  if [ "$result" = stalled ] && [ "$mode" = idle ] && ! printf '%s\n' "$screen" | tail -n 12 | grep -qiE "$BUSY_RE"; then note=' note=unproven-completion'; fi
  extra=
  [ -n "$artifact" ] && extra=" artifact_age=$artifact_age artifact_bytes=$artifact_bytes"
  [ -n "$note" ] && extra="$extra$note"
  printf '[cli-session status] session=%s cli=%s mode=%s result=%s pane=%s rc=%s turn=%s activity_age=%s screen_age=%s log_age=%s log_bytes=%s%s\n' "$n" "$c" "$mode" "$result" "$pane" "$rc" "$turn" "$activity_age" "$screen_age" "$log_age" "$log_bytes" "$extra"
  [ "$result" != gone ] && printf '%s\n' "$screen" | tail -n "$lines"
  exit "$code";;
attach-hint)
  printf 'Attach: tmux attach -t %q\nDetach: Ctrl-b d\n' "cs-$n"
  id=$(get id); c=$(get cli)
  if [ -z "$id" ]; then printf 'Native ID unknown: use the CLI session picker and restart with --native-id ID.\n'; else
    printf 'Resume after normal exit: cd %q && ' "$(get dir)"
    case $c in claude) printf 'claude -r';; codex) printf 'codex resume';; grok) printf 'grok -r';; agy) printf 'agy --conversation';; esac
    printf ' %q\n' "$id"
  fi;;
stop)
  alive || fail 'session is gone'
  [ ! -f "$MARKS/$n.exit" ] || { printf 'CLI already exited; pane and native history retained.\n'; exit 0; }
  case $(get cli) in claude) quit=/exit;; codex|grok) quit=/quit;; *) fail 'use attach-hint and exit agy normally; no automatic exit command configured';; esac
  tmux send-keys -t "=cs-$n:" -l "$quit"
  tmux send-keys -t "=cs-$n:" Enter
  printf 'Requested normal exit. Check read; pane and native history are retained.\n';;
*) usage; exit 1;;
esac
