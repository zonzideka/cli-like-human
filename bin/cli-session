#!/usr/bin/env bash
# Named, persistent terminal sessions. Compatible with Bash 3.2.
set -eo pipefail
umask 077
ROOT=${CLI_SESSIONS_HOME:-$HOME/.cli-sessions}
REG=${CLI_SESSIONS_REG:-$ROOT/registry}
LOG=${CLI_LOGS:-$HOME/.cli-sessions/logs}
MARKS=${CLI_SESSIONS_MARKS_DIR:-$ROOT/marks}
HERE=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd -P)
fail() { printf 'cli-session: %s\n' "$*" >&2; exit 1; }
valid() { [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || fail 'names and labels must use letters, digits, underscores or hyphens'; }
number() { [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || fail 'expected a positive integer'; }
get() { cat "$REG/$n/$1" 2>/dev/null || true; }
put() { printf '%s\n' "$2" > "$REG/$n/$1"; }
quote() { printf '%q' "$1"; }
json() {
  local s=$1 char i
  printf '"'
  for ((i=0; i<${#s}; i++)); do
    char=${s:i:1}
    case $char in
      \\|\") printf '\\%s' "$char";;
      *) printf '%s' "$char";;
    esac
  done
  printf '"'
}
alive() { tmux has-session -t "=cs-$n" 2>/dev/null; }
mark() { CS_NAME=$n CLI_SESSIONS_MARKS_DIR=$MARKS "$HERE/cli-session-mark" "$@"; }
usage() {
  cat <<'HELP'
Usage: cli-session start [--bot LABEL] [--native-id ID] NAME CLI [DIR] [-- CLI_ARGS...]
       cli-session send NAME TEXT... | send NAME -
       cli-session key NAME KEY...
       cli-session read NAME [LINES]
       cli-session wait NAME [--timeout SECONDS] [--stable SECONDS] [--lines N]
       cli-session list | attach-hint NAME | stop NAME | set-id NAME ID
CLI: claude, codex, grok, agy. stop requests normal exit; it never kills tmux.
set-id records a native session ID you read from the CLI, so resume works later.
HELP
}
# Confirmation prompts are modals. Persistent banner chrome must not match here:
# a banner stays on screen forever and would pin every wait to result=prompt.
PROMPT_RE='Update now|trust this folder|trust.*directory|Trust and continue|Press Enter to continue|I agree|Choose.*theme|Choose the text style|Do you want to|Allow .*\?|Run this command\?|data\.sharing'
# Strip known persistent per-CLI chrome before prompt matching.
chrome_strip() {
  case $1 in
    grok) grep -v -e 'Help improve' -e 'Off by default\. Opt-in' -e 'Read Terms and Privacy Policy';;
    *) cat;;
  esac
}
cmd=${1:-help}; [ $# -eq 0 ] || shift
case $cmd in
  help|--help|-h) usage; exit 0;;
  start|send|key|read|wait|list|attach-hint|stop|set-id) ;;
  *) usage; exit 1;;
esac
command -v python3 >/dev/null || fail 'python3 is required for native completion tracking'
command -v tmux >/dev/null || fail 'tmux is required'
case $cmd in
start)
  label=${CS_BOT:-}; native=
  while [ $# -gt 0 ]; do
    case $1 in
      --bot|--native-id) [ $# -ge 2 ] || fail 'missing option value'; case $1 in --bot) label=$2; valid "$label";; *) native=$2; valid "$native";; esac; shift 2;;
      --native-id=*) native=${1#*=}; valid "$native"; shift;;
      --bot=*) label=${1#*=}; valid "$label"; shift;;
      *) break;;
    esac
  done
  [ -z "$label" ] || valid "$label"
  [ $# -ge 2 ] || fail 'start requires NAME and CLI'
  n=$1; c=$2; shift 2; valid "$n"
  case $c in claude|codex|grok|agy) ;; *) fail 'unsupported CLI';; esac
  dir=$PWD
  if [ $# -gt 0 ] && [ "$1" != -- ]; then dir=$1; shift; fi
  [ $# -eq 0 ] || { [ "$1" = -- ] || fail 'put CLI arguments after --'; shift; }
  dir=$(cd -- "$dir" >/dev/null && pwd -P) || fail 'project directory does not exist'
  case "$dir$HERE$REG$MARKS$LOG" in *$'\n'*|*$'\r'*|*$'\t'*) fail 'paths must not contain control characters';; esac
  command -v "$c" >/dev/null || fail "CLI not found: $c"
  reuse=0
  if alive; then
    [ -f "$MARKS/$n.exit" ] || fail 'session already exists; attach or send a follow-up'
    reuse=1
  fi
  mkdir -p "$REG/$n" "$MARKS" "$LOG"
  previous=$(get cli)
  [ -z "$previous" ] || { [ "$previous" = "$c" ] && [ "$(get dir)" = "$dir" ]; } || fail 'registered name belongs to a different CLI or directory'
  id=$(get id); [ -z "$native" ] || id=$native
  [ -z "$id" ] || valid "$id"
  if [ -n "$previous" ] && [ -z "$id" ]; then fail 'native ID unknown; restart with --native-id from the native session picker'; fi
  if [ -z "$id" ]; then
    case $c in claude|grok)
      hex=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
      id=${hex:0:8}-${hex:8:4}-4${hex:13:3}-a${hex:17:3}-${hex:20:12};;
    esac
  fi
  extra=("$@")
  has() { local f arg; for f in "$@"; do for arg in "${extra[@]}"; do case $arg in "$f"|"$f"=*) return 0;; esac; done; done; return 1; }
  auto=()
  if [ "${CS_NO_AUTO:-0}" != 1 ]; then
    case $c in
      claude) has --permission-mode || auto+=(--permission-mode acceptEdits)
        has --disallowedTools --disallowed-tools || auto+=(--disallowedTools Bash);;
      codex) has -a --ask-for-approval || auto+=(-a never)
        has -s --sandbox || auto+=(-s workspace-write);;
      grok) has --always-approve --permission-mode || auto+=(--always-approve)
        has --sandbox || auto+=(--sandbox workspace);;
      agy) has --mode || auto+=(--mode accept-edits)
        has --sandbox || auto+=(--sandbox);;
    esac
  fi
  args=("$c" "${auto[@]}")
  # grok's sandbox profiles shell out to bubblewrap on Linux. Without it the CLI
  # exits during startup, which is confusing to diagnose from a dead pane.
  if [ "$c" = grok ]; then
    for arg in "${auto[@]}"; do
      if [ "$arg" = --sandbox ]; then
        if [ "$(uname -s)" = Linux ] && ! command -v bwrap >/dev/null; then
          fail 'grok needs bubblewrap on Linux: install it (apt install -y bubblewrap) or set CS_NO_AUTO=1 to start without the driver sandbox default'
        fi
      fi
    done
  fi
  hook=$HERE/cli-session-hook
  case $c in
    claude)
      if [ -n "$previous$native" ]; then args+=(-r "$id"); else args+=(-n "$n" --session-id "$id"); fi
      start_hook="$(quote "$hook") start"; done_hook="$(quote "$hook") done"
      settings='{"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":'$(json "$start_hook")'}]}],"Stop":[{"hooks":[{"type":"command","command":'$(json "$done_hook")'}]}]}}'
      args+=(--settings "$settings");;
    codex) [ -z "$id" ] || args+=(resume "$id")
      args+=(-c "notify=[$(json "$hook"),\"done\"]");;
    grok) if [ -n "$previous$native" ]; then args+=(-r "$id"); else args+=(-s "$id"); fi;;
    agy) [ -z "$id" ] || args+=(--conversation "$id");;
  esac
  args+=("${extra[@]}")
  put cli "$c"; put dir "$dir"; put id "$id"
  [ -z "$label" ] || put bot "$label"
  rm -f "$MARKS/$n.sent" "$MARKS/$n.start" "$MARKS/$n.done" "$MARKS/$n.exit"
  # Persist a quoted launcher, not a transcript or a second native session store.
  launcher=$REG/$n/launch
  {
    printf '#!/usr/bin/env bash\n'
    printf 'export CS_NAME=%q CLI_SESSIONS_HOME=%q CLI_SESSIONS_REG=%q CLI_SESSIONS_MARKS_DIR=%q\n' "$n" "$ROOT" "$REG" "$MARKS"
    printf 'set +e\n'
    printf '%q ' "${args[@]}"; printf '\nrc=$?\n'
    # shellcheck disable=SC2016
    printf '%q exit "$rc"\n' "$HERE/cli-session-mark"
    # shellcheck disable=SC2016
    printf 'exit "$rc"\n'
  } > "$launcher"
  # A gated pane lets logging attach before the CLI starts. Exited panes stay visible.
  gate=$REG/$n/ready; rm -f "$gate"
  run="while [ ! -f $(quote "$gate") ]; do sleep 1; done; exec bash $(quote "$launcher")"
  if [ "$reuse" = 1 ]; then
    tmux respawn-pane -t "=cs-$n:" -c "$dir" "$run" || fail 'could not respawn session pane'
  else
    tmux new-session -d -s "cs-$n" -x 200 -y 50 -c "$dir" "$run" || fail 'could not create session'
  fi
  tmux set-option -t "=cs-$n:" remain-on-exit on || fail 'could not configure retained pane'
  tmux pipe-pane -t "=cs-$n:" -o "cat >> $(quote "$LOG/$n.tty.log")" || fail 'could not configure terminal logging'
  : > "$gate"
  printf 'Started %s (%s). Use cli-session read %s before sending.\n' "$n" "$c" "$n"
  exit 0;;
list)
  printf 'NAME\tCLI\tNATIVE_ID\tLABEL\tDIRECTORY\n'
  for entry in "$REG"/*; do [ -d "$entry" ] || continue; n=${entry##*/}; printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$(get cli)" "$(get id)" "$(get bot)" "$(get dir)"; done
  exit 0;;
esac
[ $# -ge 1 ] || fail 'missing session name'
n=$1; shift; valid "$n"
if [ ! -d "$REG/$n" ]; then
  if [ "$cmd" = wait ]; then
    printf '[cli-session wait] session=%s cli=unknown mode=unknown result=gone elapsed=0s\n' "$n"
    exit 4
  fi
  fail 'unknown session'
fi
case $cmd in
send)
  [ $# -gt 0 ] || fail 'missing text'
  alive && [ ! -f "$MARKS/$n.exit" ] || fail 'CLI has exited'
  # Refuse overlapping dispatches instead of attributing the old completion to a new turn.
  if [ -f "$MARKS/$n.sent" ]; then
    case $(get cli) in
      agy|grok)
        prior=$("$HERE/cli-session-native" status "$n")
        case $prior in busy|pending) fail 'previous turn is still pending; read/wait or resolve its prompt before sending';; esac;;
      codex|claude)
        [ "$(cat "$MARKS/$n.sent")" = "$(cat "$MARKS/$n.done" 2>/dev/null || true)" ] || fail 'previous turn is still pending; read/wait before sending';;
    esac
  fi
  f=$(mktemp "$REG/$n/input.XXXXXXXX"); trap 'rm -f "$f"' EXIT
  if [ "$1" = - ]; then cat > "$f"; else printf '%s' "$*" > "$f"; fi
  # Serialize turns at the caller: a new dispatch invalidates previous done marks.
  mark sent
  CS_NAME=$n CLI_SESSIONS_HOME=$ROOT CLI_SESSIONS_REG=$REG CLI_SESSIONS_MARKS_DIR=$MARKS "$HERE/cli-session-native" prepare "$n"
  tmux load-buffer -b "cs-$n" "$f"
  tmux paste-buffer -p -d -b "cs-$n" -t "=cs-$n:"
  sleep 1
  [ ! -f "$MARKS/$n.exit" ] || fail 'CLI exited during paste'
  tmux send-keys -t "=cs-$n:" Enter;;
key) [ $# -gt 0 ] || fail 'missing key'; [ ! -f "$MARKS/$n.exit" ] || fail 'CLI has exited'; tmux send-keys -t "=cs-$n:" "$@";;
read) lines=${1:-60}; number "$lines"; tmux capture-pane -p -J -t "=cs-$n:" -S "-$lines";;
wait)
  timeout=3600; stable=6; lines=15
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || fail 'missing wait option value'; number "$2"
    case $1 in --timeout) timeout=$2;; --stable) stable=$2;; --lines) lines=$2;; *) fail 'unknown wait option';; esac; shift 2
  done
  c=$(get cli); mode=idle; case $c in claude|codex) mode=hook;; esac
  token=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
  started=0; last=; same=0; begin=$SECONDS; rc=2; result=timeout
  while [ $((SECONDS-begin)) -lt "$timeout" ]; do
    screen=$(tmux capture-pane -p -J -t "=cs-$n:" 2>/dev/null) || { rc=4; result=gone; break; }
    current=$(cat "$MARKS/$n.sent" 2>/dev/null || true)
    [ "$current" = "$token" ] || fail 'another dispatch replaced this turn'
    if [ -f "$MARKS/$n.exit" ]; then rc=4; result=gone; break; fi
    if [ -n "$token" ] && [ "$(cat "$MARKS/$n.done" 2>/dev/null || true)" = "$token" ] && [ "$mode" = hook ]; then rc=0; result='done'; break; fi
    native=$(CLI_SESSIONS_HOME=$ROOT CLI_SESSIONS_REG=$REG CLI_SESSIONS_MARKS_DIR=$MARKS "$HERE/cli-session-native" status "$n")
    case $native in
      done) mode=native; rc=0; result=done; break;;
      failed) mode=native; rc=5; result=failed; break;;
      pending|busy) mode=native;;
    esac
    if printf '%s\n' "$screen" | tail -n 20 | chrome_strip "$c" | grep -qiE "$PROMPT_RE"; then rc=3; result=prompt; break; fi
    busy=0
    printf '%s\n' "$screen" | tail -n 12 | grep -qiE 'esc to interrupt|ctrl\+c:cancel|esc to cancel|ctrl\+c to (stop|interrupt)|Waiting for response|Working|Thinking|Running|Generating' && busy=1
    [ "$busy" = 0 ] || started=1
    if [ "$mode" = idle ] && [ -n "$token" ] && [ "$started" = 1 ] && [ "$busy" = 0 ] && [ "$screen" = "$last" ]; then
      same=$((same+1)); if [ "$same" -ge "$stable" ]; then rc=0; result='done'; break; fi
    else same=0; fi
    last=$screen; sleep 1
  done
  printf '[cli-session wait] session=%s cli=%s mode=%s result=%s elapsed=%ss\n' "$n" "$c" "$mode" "$result" "$((SECONDS-begin))"
  printf '%s\n' "${screen:-}" | tail -n "$lines"
  exit "$rc";;
attach-hint)
  printf 'Attach: tmux attach -t %q\nDetach: Ctrl-b d\n' "cs-$n"
  id=$(get id); c=$(get cli)
  if [ -z "$id" ]; then
    printf 'Native ID unknown: use the CLI session picker and restart with --native-id ID.\n'
    printf 'If the CLI exposes an ID on screen, record it without restarting: cli-session set-id %s ID\n' "$n"
  else
    printf 'Resume after normal exit: cd %q && ' "$(get dir)"
    case $c in claude) printf 'claude -r';; codex) printf 'codex resume';; grok) printf 'grok -r';; agy) printf 'agy --conversation';; esac
    printf ' %q\n' "$id"
  fi;;
set-id)
  # Record a native session ID the CLI reported, so resume survives a later restart.
  # Never guessed from shared storage: the caller supplies the observed value.
  [ $# -ge 1 ] || fail 'missing native ID'
  valid "$1"
  put id "$1"
  printf 'Recorded native ID for %s. Verify with attach-hint %s\n' "$n" "$n";;
stop)
  alive || fail 'session is gone'
  [ ! -f "$MARKS/$n.exit" ] || { printf 'CLI already exited; pane and native history retained.\n'; exit 0; }
  case $(get cli) in claude) quit=/exit;; codex|grok|agy) quit=/quit;; *) fail 'unsupported CLI';; esac
  tmux send-keys -t "=cs-$n:" -l "$quit"
  sleep 1
  tmux send-keys -t "=cs-$n:" Enter
  printf 'Requested normal exit. Check read; pane and native history are retained.\n';;
*) usage; exit 1;;
esac
